[Unit]
Description=Petrel display interface
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@PETREL_USER@
@SUPPLEMENTARY_GROUPS@
WorkingDirectory=@PETREL_HOME@/Petrel
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@PETREL_HOME@/.config/Petrel/Petrel.env
ExecStart=@PETREL_HOME@/petrel-env/bin/python @PETREL_HOME@/Petrel/run.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
